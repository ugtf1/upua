# ─────────────────────────────────────────────────────────────────
# UPUA Member Portal — Environment Variables Reference
# Copy relevant vars to .env.local for local dev
# All production values are injected by Cloud Run from Secret Manager
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Local SQLite (dev only — do NOT use in production)
DATABASE_URL="file:./dev.db"

# Cloud SQL (PostgreSQL) via Cloud SQL Auth Proxy (used in Cloud Run production):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost/upua_db?host=/cloudsql/top-cedar-471512-k3:us-east1:upuadb"

# Direct TCP connection (for local testing against Cloud SQL with Cloud SQL Proxy running):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/upua_db"

# ── Auth ──────────────────────────────────────────────────────────
# Generate a unique random value for each environment; do not commit it.
# AUTH_SECRET="replace-with-a-unique-random-secret"

# ── AI — Gemini 2.0 Flash (Meeting Note Summariser) ───────────────
# Get free key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="your-gemini-api-key-here"

# ── Stripe Payments ───────────────────────────────────────────────
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."?

# ── QuickBooks Online ─────────────────────────────────────────────
# Get credentials from: https://developer.intuit.com (My Apps > QuickBooks Online Accounting)
# Redirect URI to register in Intuit App: https://upua-30228073381.us-east1.run.app/api/quickbooks/callback
QB_CLIENT_ID="your-intuit-client-id"
QB_CLIENT_SECRET="your-intuit-client-secret"
QB_REDIRECT_URI="https://upua-30228073381.us-east1.run.app/api/quickbooks/callback"
QB_ENVIRONMENT="sandbox" # or "production"

# (Also supports aliases QUICKBOOKS_CLIENT_ID, QUICKBOOKS_CLIENT_SECRET, QUICKBOOKS_REDIRECT_URI)

# ── Site URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://upua-30228073381.us-east1.run.app"

# ── GitHub CMS Auto-Publisher (Optional) ──────────────────────────
# Personal Access Token with repo write permissions to allow portal CMS edits to auto-commit
# GITHUB_TOKEN="ghp_..."
# GITHUB_REPOSITORY="ugtf1/upua"
# GITHUB_BRANCH="master"
