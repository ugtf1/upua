// Prisma Schema for Urhobo Progress Union America (UPUA)
// Configured for PostgreSQL (Cloud SQL / Supabase / Neon / RDS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    // "admin" | "chapter" | "member"
  chapterId    String?
  phone        String?
  title        String?
  avatar       String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Chapter {
  id                    String    @id
  name                  String
  code                  String    @unique
  region                String
  president             String
  contactPhone          String?
  contactEmail          String
  memberCount           Int       @default(0)
  website               String?

  // Multi-Year Dues & Member Counts from official audit
  members2023           Float     @default(0)
  dues2023Exp           Float     @default(0)
  dues2023Paid          Float     @default(0)

  members2024           Float     @default(0)
  dues2024Exp           Float     @default(0)
  dues2024Paid          Float     @default(0)

  members2025           Float     @default(0)
  dues2025Exp           Float     @default(0)
  dues2025Paid          Float     @default(0)

  members2026           Float     @default(0)
  dues2026Exp           Float     @default(0)
  dues2026Paid          Float     @default(0)

  // Net Dues Balance
  duesBalance           Float     @default(0)

  // Insurance Premiums
  insurance2023Paid     Float     @default(0)
  insurance2024Paid     Float     @default(0)
  insurance2025Paid     Float     @default(0)
  insuranceTotal        Float     @default(0)
  insuranceColonial     Float     @default(0)

  // Raffle Tickets
  raffleStatus          String?   @default("Sent")
  raffleSent            Float     @default(0)
  rafflePaid            Float     @default(0)
  raffleBalance         Float     @default(0)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  members               Member[]
  payments              Payment[]
}

model Member {
  id           String    @id @default(cuid())
  chapterId    String
  chapter      Chapter   @relation(fields: [chapterId], references: [id])
  name         String
  email        String    @unique
  phone        String?
  status       String    @default("Active") // "Active" | "Pending" | "Lapsed"
  duesStatus   String    @default("Paid")   // "Paid" | "Outstanding" | "Exempt"
  role         String    @default("Member") // "Member" | "Executive" | "Youth" | "Patron"
  joinedDate   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
}

model Payment {
  id                    String   @id @default(cuid())
  chapterId             String
  chapter               Chapter  @relation(fields: [chapterId], references: [id])
  memberId              String?
  member                Member?  @relation(fields: [memberId], references: [id])
  memberName            String
  category              String   // "monthly_dues" | "donation" | "ticket" | "merchandise"
  amount                Float
  date                  String   // ISO YYYY-MM-DD
  description           String
  paymentMethod         String   @default("zelle") // "zelle" | "counter_credit" | "wire" | "check" | "cash_app" | "cash" | "stripe"
  confirmationNo        String?
  stripePaymentIntentId String?
  status                String   @default("completed") // "completed" | "pending" | "failed"
  createdAt             DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  category    String   // "Humanitarian Aid" | "Medical Supplies" | "STEM & AI Lab" | "Convention Logistics" | "Administrative" | "Youth Programs"
  amount      Float
  date        String   // ISO YYYY-MM-DD
  description String
  approvedBy  String
  vendor      String
  status      String   @default("Approved") // "Approved" | "Paid" | "Pending"
  createdAt   DateTime @default(now())
}

model Meeting {
  id           String   @id @default(cuid())
  title        String
  date         String   // ISO YYYY-MM-DD
  chapterId    String?  // null indicates National General Assembly
  duration     String
  recordedBy   String
  audioBlobUrl String?
  transcript   String   // Full transcription text
  summary      String   // Executive AI summary
  keyDecisions String   // JSON string of string[]
  actionItems  String   // JSON string of { task, owner, deadline }[]
  createdAt    DateTime @default(now())
}

model StoreItem {
  id          String   @id
  title       String
  category    String   // "Convention Packages" | "Apparel & Regalia" | "Books & Culture" | "Accessories"
  price       Float
  image       String
  badge       String?
  description String
  features    String   // JSON string of string[]
  options     String?  // JSON string of string[] | null
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
